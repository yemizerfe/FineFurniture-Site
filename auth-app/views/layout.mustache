<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <meta name="description" content="A small account system: sign up, log in, and see your profile." />
    <link rel="stylesheet" href="/style.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%236d5efc'/%3E%3Cpath d='M10 22V10l12 12V10' stroke='white' stroke-width='2.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="glow glow-one" aria-hidden="true"></div>
    <div class="glow glow-two" aria-hidden="true"></div>

    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span class="brand-name">Nimbus</span>
        </a>
        {{#user}}
        <div class="topbar-right">
          <span class="who">{{user.username}}</span>
          <form method="post" action="/logout" class="inline-form">
            <button class="btn btn-ghost btn-small" type="submit">Log out</button>
          </form>
        </div>
        {{/user}}
        {{^user}}
        <nav class="topbar-right">
          <a class="btn btn-ghost btn-small" href="/login">Log in</a>
          <a class="btn btn-primary btn-small" href="/signup">Create account</a>
        </nav>
        {{/user}}
      </header>

      <main class="main">{{> page}}</main>

      <footer class="footer">
        <span>Nimbus accounts</span>
        <span class="dot-sep">·</span>
        <span>Mustache templates · Cloudflare Workers · D1</span>
      </footer>
    </div>
  </body>
</html>
