<section class="card">
  <div class="card-head">
    <h1>Create your account</h1>
    <p class="sub">One minute, no email confirmation. Just a username, an email and a password.</p>
  </div>

  {{#error}}
  <div class="alert alert-error" role="alert">
    <span class="alert-icon" aria-hidden="true">!</span>
    <span>{{error}}</span>
  </div>
  {{/error}}

  <form method="post" action="/signup" class="form" autocomplete="on">
    <div class="field{{#field_is_username}} field-invalid{{/field_is_username}}">
      <label for="username">Username</label>
      <input
        id="username"
        name="username"
        type="text"
        value="{{values.username}}"
        placeholder="ada_lovelace"
        autocomplete="username"
        minlength="3"
        maxlength="30"
        required
      />
      <p class="hint">3–30 characters. Letters, numbers, dot, dash or underscore.</p>
    </div>

    <div class="field{{#field_is_email}} field-invalid{{/field_is_email}}">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        value="{{values.email}}"
        placeholder="you@example.com"
        autocomplete="email"
        maxlength="320"
        required
      />
    </div>

    <div class="field{{#field_is_password}} field-invalid{{/field_is_password}}">
      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        placeholder="At least 8 characters"
        autocomplete="new-password"
        minlength="8"
        required
      />
      <p class="hint">Stored as a PBKDF2-SHA256 hash, never in plain text.</p>
    </div>

    <div class="field{{#field_is_confirm}} field-invalid{{/field_is_confirm}}">
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" placeholder="Repeat it" autocomplete="new-password" required />
    </div>

    <button class="btn btn-primary btn-block" type="submit">Create account</button>
  </form>

  <p class="alt">Already have an account? <a href="/login">Log in</a></p>
</section>

<aside class="side-note">
  <p class="side-title">What you get</p>
  <ul class="ticks">
    <li>A profile page with your username and email</li>
    <li>A session cookie that lasts seven days</li>
    <li>Passwords hashed with a per-user random salt</li>
  </ul>
</aside>
