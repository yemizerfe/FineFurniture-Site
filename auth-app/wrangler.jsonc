// Local development config. The deployed Worker is configured by Freebuff Sites.
{
  "name": "nimbus-auth",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "rules": [{ "type": "Text", "globs": ["**/*.mustache"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nimbus-auth-db",
      "database_id": "d4f1e2a7-5c93-4b18-8e6a-3f7c1b9d2e50",
      "preview_database_id": "d4f1e2a7-5c93-4b18-8e6a-3f7c1b9d2e50"
    }
  ]
}
